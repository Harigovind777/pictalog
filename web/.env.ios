# Used by `npm run ios`. The app runs from its own local origin, so it needs the server's full address.
# On the iPhone simulator, localhost is this Mac. Change these to the hosted addresses once the server is online.
VITE_API_BASE=http://localhost:8000
VITE_PUBLIC_URL=http://localhost:5173

# Play the launch intro when the app opens.
VITE_INTRO=on
